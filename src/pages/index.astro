---
const siteUrl = 'https://305discount.com';
const title = '305 Discount | Furniture, Appliances & Mattresses in Miami';
const description =
  '305 Discount is launching a Miami wholesale catalog for furniture, appliances, mattresses, and verified liquidation inventory. Coming soon.';
const socialImage = `${siteUrl}/og-image.png`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: '305 Discount',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/brand-logo.webp`,
        width: 2048,
        height: 719,
      },
      image: {
        '@type': 'ImageObject',
        url: socialImage,
        width: 1200,
        height: 630,
      },
      telephone: '+1-954-254-0056',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Miami',
        addressRegion: 'FL',
        addressCountry: 'US',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: '305 Discount',
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/#webpage`,
      url: `${siteUrl}/`,
      name: title,
      description,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      about: {
        '@id': `${siteUrl}/#organization`,
      },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: socialImage,
        width: 1200,
        height: 630,
      },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta name="application-name" content="305 Discount" />
    <meta name="apple-mobile-web-app-title" content="305 Discount" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/brand-logo.webp"
      as="image"
      type="image/webp"
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="305 Discount" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="305 Discount — Furniture, Appliances & Mattresses — Coming Soon"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="305 Discount — Furniture, Appliances & Mattresses — Coming Soon"
    />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <main class="main-container">
      <header class="brand-section">
        <div class="logo-frame">
          <img
            src="/brand-logo.webp"
            alt="305 Discount — Furniture, Appliances &amp; Mattresses — 954-254-0056"
            class="brand-logo"
            width="2048"
            height="719"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <div class="tagline-badge">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Online Wholesale Catalog</span>
        </div>
      </header>

      <section class="content-section" aria-labelledby="coming-soon-title">
        <h1 class="headline" id="coming-soon-title">Coming Soon</h1>
        <p class="description">
          We're launching our direct liquidation catalog with verified Miami inventory.
          Furniture, appliances and mattresses — coming soon.
        </p>
      </section>

      <footer class="footer-meta">
        <span>&copy; 305discount.com</span>
        <span aria-hidden="true">&bull;</span>
        <span>Miami, FL</span>
        <span aria-hidden="true">&bull;</span>
        <a href="/contact">Contact</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: oklch(98.8% 0.002 240);
    --surface: oklch(100% 0 0);
    --fg: oklch(18% 0.015 250);
    --muted: oklch(48% 0.015 250);
    --border: oklch(91% 0.005 250);
    --accent: oklch(52% 0.22 255);

    --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', system-ui, sans-serif;
    --font-body: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    --font-mono: ui-monospace, 'JetBrains Mono', Menlo, monospace;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--bg);
  }

  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: 1.5rem;
    background-color: var(--bg);
    background-image: radial-gradient(
      ellipse at 50% 30%,
      oklch(96% 0.01 250 / 0.75),
      transparent 70%
    );
    color: var(--fg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  .main-container {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.75rem 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.03),
      0 8px 24px -6px oklch(0% 0 0 / 0.04);
  }

  .brand-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-bottom: 2rem;
  }

  .logo-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 300px;
    min-height: 100px;
    margin-bottom: 1.25rem;
  }

  .brand-logo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .tagline-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--bg);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.45;
      transform: scale(0.9);
    }
  }

  .content-section {
    width: 100%;
  }

  .headline {
    margin-bottom: 0.75rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .description {
    max-width: 360px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
  }

  .footer-meta a {
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-meta a:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    body {
      padding: 1rem;
    }

    .main-container {
      padding: 2.25rem 1.25rem;
      border-radius: 20px;
    }

    .logo-frame {
      max-width: 280px;
    }

    .headline {
      font-size: 2rem;
    }
  }
</style>
