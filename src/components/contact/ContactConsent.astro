<div class="consent-box">
  <label class="consent-row">
    <input id="transactional-consent" name="transactionalConsent" type="checkbox" />
    <span>
      I consent to receive transactional messages related to my account, orders, or services requested from
      <strong>305 Discount</strong>. Message frequency may vary. Message and data rates may apply. Reply STOP to opt out.
    </span>
  </label>

  <label class="consent-row">
    <input id="marketing-consent" name="marketingConsent" type="checkbox" />
    <span>
      I consent to receive marketing and promotional messages from <strong>305 Discount</strong>, including offers,
      discounts, inventory updates, and new products. Message frequency may vary. Message and data rates may apply.
      Reply STOP to opt out.
    </span>
  </label>
</div>
