---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  updated?: string;
}

const {
  title,
  description,
  eyebrow = '305 Discount',
  updated,
} = Astro.props;

const siteUrl = 'https://305discount.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 305 Discount</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="305 Discount home">
        <img src="/brand-logo.webp" alt="305 Discount" width="2048" height="719" />
      </a>
      <nav aria-label="Legal and contact navigation">
        <a href="/contact">Contact</a>
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="hero">
        <a class="back-link" href="/">← Back to home</a>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {updated && <p class="updated">Last updated: {updated}</p>}
      </section>

      <section class="content-card">
        <slot />
      </section>
    </main>

    <footer class="site-footer">
      <span>© 305discount.com</span>
      <span>Miami, FL</span>
      <a href="/contact">Contact</a>
      <a href="/terms">Terms &amp; Conditions</a>
      <a href="/privacy">Privacy Policy</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: oklch(98.8% 0.002 240);
    --surface: #fff;
    --fg: oklch(18% 0.015 250);
    --muted: oklch(48% 0.015 250);
    --border: oklch(91% 0.005 250);
    --accent: oklch(52% 0.22 255);
    --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', system-ui, sans-serif;
    --font-body: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', system-ui, sans-serif;
    --font-mono: ui-monospace, 'JetBrains Mono', Menlo, monospace;
  }

  * { box-sizing: border-box; }

  html { background: var(--bg); }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 15% 5%, oklch(96% 0.018 255 / .8), transparent 28rem),
      var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; }

  .site-header {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.25rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand img {
    display: block;
    width: 168px;
    height: auto;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .85rem;
  }

  .site-header nav a,
  .site-footer a {
    color: var(--muted);
    font-size: .8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-footer a:hover {
    color: var(--accent);
  }

  .page-shell {
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
  }

  .hero {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .back-link:hover { color: var(--accent); }

  .eyebrow,
  .updated {
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .eyebrow { color: var(--accent); }

  h1 {
    margin: .65rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 6vw, 4.75rem);
    line-height: .98;
    letter-spacing: -.055em;
  }

  .lede {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 1.03rem;
    line-height: 1.7;
  }

  .updated {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--muted), transparent 20%);
  }

  .content-card {
    padding: clamp(1.35rem, 4vw, 3rem);
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 24px 60px -36px rgba(10, 20, 40, .28);
  }

  .legal-section + .legal-section {
    margin-top: 2.15rem;
    padding-top: 2.15rem;
    border-top: 1px solid var(--border);
  }

  .legal-section h2 {
    margin: 0 0 .85rem;
    font-size: 1.02rem;
    letter-spacing: -.015em;
  }

  .legal-section p,
  .legal-section li {
    color: color-mix(in srgb, var(--fg), transparent 24%);
    font-size: .92rem;
    line-height: 1.75;
  }

  .legal-section p { margin: .6rem 0; }
  .legal-section ul { margin: .65rem 0 0; padding-left: 1.2rem; }
  .legal-section li + li { margin-top: .3rem; }

  .site-footer {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
    color: var(--muted);
    font-size: .78rem;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field {
    display: block;
    font-size: .82rem;
    font-weight: 700;
  }

  .field input,
  .field textarea {
    width: 100%;
    margin-top: .5rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #fff;
    color: var(--fg);
    font: inherit;
    font-weight: 500;
    padding: .85rem 1rem;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px oklch(52% .22 255 / .1);
  }

  .field textarea { resize: vertical; min-height: 130px; }

  .consent-box {
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg);
  }

  .consent-row {
    display: flex;
    align-items: flex-start;
    gap: .7rem;
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.55;
    cursor: pointer;
  }

  .consent-row + .consent-row { margin-top: .8rem; }

  .consent-row input {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: .15rem;
    accent-color: var(--accent);
  }

  .form-actions {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .form-actions small {
    color: var(--muted);
    line-height: 1.5;
  }

  .form-actions a { color: var(--accent); }

  .primary-button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: var(--fg);
    color: #fff;
    padding: .85rem 1.2rem;
    font: inherit;
    font-size: .84rem;
    font-weight: 750;
    cursor: pointer;
    transition: transform .2s, opacity .2s;
  }

  .primary-button:hover {
    transform: translateY(-1px);
    opacity: .9;
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-header nav { justify-content: flex-start; }

    .page-shell { padding-top: 2.25rem; }

    .field-grid { grid-template-columns: 1fr; }

    .form-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-button { width: 100%; }
  }
</style>
